{
  "name": "euge-buteler-coach",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contacto", "/api/contacto/"]
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      { "binding": "CONTACT_QUEUE", "queue": "euge-contact" }
    ],
    "consumers": [
      {
        "queue": "euge-contact",
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "euge-contact-dlq"
      }
    ]
  },
  "previews": {
    "queues": {
      "producers": [
        { "binding": "CONTACT_QUEUE", "queue": "euge-contact-preview" }
      ]
    }
  },
  "env": {
    "preview": {
      "vars": {
        "CONTACT_DELIVERY_MODE": "simulate"
      },
      "queues": {
        "producers": [
          { "binding": "CONTACT_QUEUE", "queue": "euge-contact-preview" }
        ],
        "consumers": [
          {
            "queue": "euge-contact-preview",
            "max_batch_timeout": 1,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "euge-contact-preview-dlq"
          }
        ]
      }
    }
  }
}

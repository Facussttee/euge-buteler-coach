---
import { site } from '../data/site'
---

<form
  class="contact-form"
  name="consulta-mentoria"
  method="POST"
  action="/api/contacto"
  data-ig-url={site.instagram.messageUrl}
>
  <h3>O escribime desde acá</h3>
  <p hidden>
    <label>Dejá este campo vacío <input name="_honey" tabindex="-1" autocomplete="off" /></label>
    <label>No completar <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <label for="contact-name">Nombre</label>
  <input id="contact-name" name="name" autocomplete="name" placeholder="Ej: Lucía" maxlength="120" required />

  <label for="contact-email">Correo electrónico</label>
  <input
    id="contact-email"
    name="email"
    type="email"
    inputmode="email"
    autocomplete="email"
    spellcheck="false"
    maxlength="254"
    placeholder="tu@correo.com"
    required
  />

  <label for="contact-message">¿Qué te gustaría consultar?</label>
  <textarea
    id="contact-message"
    name="message"
    rows="4"
    maxlength="5000"
    placeholder="Contame en dos líneas qué te pasa hoy o qué querés trabajar en la mentoría…"
    required
  ></textarea>

  <p class="form-note">Lo leo yo personalmente y te respondo en 24 a 48 hs hábiles. Tus datos se usan solo para contestarte.</p>
  <button class="button" type="submit">Enviar consulta</button>
  <p class="form-status" role="alert"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form[name="consulta-mentoria"]')
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
  const status = form?.querySelector<HTMLElement>('.form-status')
  const initialButtonLabel = button?.textContent ?? 'Enviar consulta'
  let submitting = false

  function resetSubmitState() {
    if (!form || !button) return
    button.disabled = false
    button.textContent = initialButtonLabel
    form.removeAttribute('aria-busy')
  }

  if (form && button && status) {
    const showFailure = (message: string) => {
      submitting = false
      resetSubmitState()
      button.textContent = 'Reintentar'
      status.textContent = message
      const link = document.createElement('a')
      link.href = form.dataset.igUrl || 'https://www.instagram.com/eugebuteler.coach/'
      link.textContent = 'escribime por Instagram ↗'
      status.append(link, '.')
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted && !submitting && button.disabled) resetSubmitState()
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (button.disabled) return

      const nameInput = form.querySelector<HTMLInputElement>('[name="name"]')
      const messageInput = form.querySelector<HTMLTextAreaElement>('[name="message"]')
      for (const field of [nameInput, messageInput]) {
        if (field && field.value.trim().length === 0) {
          field.value = ''
          field.reportValidity()
          field.focus()
          return
        }
      }

      const honeyInput = form.querySelector<HTMLInputElement>('[name="_honey"]')
      const botInput = form.querySelector<HTMLInputElement>('[name="bot-field"]')
      if (honeyInput?.value || botInput?.value) {
        return
      }

      if (!navigator.onLine) {
        showFailure('No se pudo enviar tu consulta porque no hay conexión. Cuando vuelvas a tener conexión, reintentá o ')
        return
      }

      submitting = true
      button.disabled = true
      form.setAttribute('aria-busy', 'true')
      button.textContent = 'Enviando…'
      status.textContent = ''

      try {
        const body = new URLSearchParams()
        for (const [name, value] of new FormData(form)) {
          if (typeof value === 'string') body.append(name, value)
        }

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        })

        const result: unknown = await response.json()
        const success = result && typeof result === 'object' && 'success' in result ? result.success : undefined
        if (response.status === 202 && success === true) {
          submitting = false
          window.location.assign('/gracias/')
          return
        }

        if (response.status >= 400 && success === false) {
          showFailure('No se pudo enviar tu consulta. Reintentá o ')
          return
        }
      } catch {
        // Sin una respuesta válida no sabemos si el sitio registró la consulta.
      }
      showFailure('No pudimos confirmar si recibí tu consulta. Podés reintentar o ')
    })
  }
</script>

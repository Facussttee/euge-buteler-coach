---
const canSend = import.meta.env.NETLIFY === 'true'
---

<form
  class="contact-form"
  name="consulta-mentoria"
  method="POST"
  action="/gracias/"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <h3>También podés escribirme desde acá</h3>
  <input type="hidden" name="form-name" value="consulta-mentoria" />
  <p hidden><label>Dejá este campo vacío <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <label for="contact-name">Nombre</label>
  <input id="contact-name" name="name" autocomplete="name" required />

  <label for="contact-email">Correo electrónico</label>
  <input id="contact-email" name="email" type="email" autocomplete="email" spellcheck="false" required />

  <label for="contact-message">¿Qué te gustaría consultar?</label>
  <textarea id="contact-message" name="message" rows="4" required></textarea>

  <p class="form-note">Uso estos datos para responderte por correo.</p>
  <button class="button" type="submit" disabled={!canSend}>Enviar consulta</button>
  {!canSend && <p class="form-note">El envío por formulario estará disponible en el sitio publicado.</p>}
  <p class="form-status" role="status"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form[name="consulta-mentoria"]')
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
  const status = form?.querySelector<HTMLElement>('[role="status"]')

  if (form && button && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (button.disabled) return

      button.disabled = true
      form.setAttribute('aria-busy', 'true')
      button.textContent = 'Enviando…'
      status.textContent = 'Enviando consulta…'

      try {
        const body = new URLSearchParams()
        for (const [name, value] of new FormData(form)) {
          if (typeof value === 'string') body.append(name, value)
        }

        const response = await fetch(form.action, {
          method: 'POST',
          body,
        })
        if (!response.ok) throw new Error('El envío no fue aceptado')
        window.location.assign(form.action)
      } catch {
        form.removeAttribute('aria-busy')
        status.textContent = 'No se pudo enviar tu consulta. Revisá tu conexión o escribime por Instagram.'
        button.textContent = 'Reintentar'
        button.disabled = false
      }
    })
  }
</script>

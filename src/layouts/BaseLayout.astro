---
import '@fontsource-variable/dm-sans'
import '@fontsource-variable/source-serif-4'
import '@fontsource-variable/source-serif-4/wght-italic.css'
import '../styles/site.css'
import { site } from '../data/site'

interface Props {
  title?: string
  noindex?: boolean
}

const { title = site.title, noindex = false } = Astro.props
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site)
const cfBranch = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.CF_PAGES_BRANCH
const preventIndexing = noindex || !import.meta.env.PROD || Boolean(cfBranch && cfBranch !== 'main')
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#FAF6EF" />
    {preventIndexing && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:image" content={new URL('/compartir.png', canonical)} />}
    {canonical && <meta property="og:image:alt" content="Euge Buteler, mentoría 1 a 1" />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

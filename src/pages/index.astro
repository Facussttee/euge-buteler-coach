---
import { Image } from 'astro:assets'
import portrait from '../assets/euge-buteler.png'
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm.astro'
import YouTubePlaylist from '../components/YouTubePlaylist.astro'
import { site } from '../data/site'
---

<BaseLayout>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href="/" aria-label={site.name + ', inicio'}>{site.name}<span aria-hidden="true">.</span></a>
      <nav aria-label="Principal">
        <a href="#mentoria">Mentoría</a>
        <a href="#sobre-euge">Sobre mí</a>
        <a href="#videos">Videos</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <section class="wrap hero" aria-labelledby="portada">
      <div class="hero-copy">
        <p class="overline">Mentoría 1 a 1</p>
        <h1 id="portada">{site.headline.opening} <em>{site.headline.emphasis}</em></h1>
        <p class="lead">{site.description}</p>
        <div class="hero-actions">
          <a class="button instagram-primary" href={site.instagram.messageUrl}>
            {site.contactLabel}<span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="instagram-profile" href={site.youtube.channelUrl}>
            Mi YouTube · <span>{site.youtube.handle}</span>
          </a>
          <a class="text-link" href="#mentoria">Conocé cómo trabajo <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <Image
        class="hero-portrait"
        src={portrait}
        widths={[320, 480, 640]}
        sizes="(min-width: 76rem) 28.5rem, (min-width: 42rem) 42vw, calc(100vw - 2rem)"
        alt="Retrato de Euge Buteler, sonriendo con un blazer blanco"
        priority
      />
    </section>

    <section class="mentoring band" id="mentoria" aria-labelledby="titulo-mentoria">
      <div class="wrap">
        <div class="mentoring-head">
          <h2 id="titulo-mentoria">Cómo trabajo con vos</h2>
          <div class="mentoring-intro">
            <p class="section-intro">En mis mentorías 1 a 1 te acompaño a reconocer tus talentos, fortalecer tu liderazgo y ganar claridad sobre lo que querés. Buscamos herramientas para cuidar tu energía y tomar decisiones con más confianza en tu propio criterio.</p>
            <p class="section-intro">Partimos de situaciones que te pasan todos los días.</p>
          </div>
        </div>
        <ul class="scenarios process-steps">
          {site.scenarios.map(({ title, body }, index) => (
            <li>
              <div class="step-track" aria-hidden="true">
                <span class="step-num">Paso 0{index + 1}</span>
                <span class="step-line"></span>
                <span class="step-arrow">→</span>
              </div>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ul>
        <p class="first-step">
          <span class="step-arrow" aria-hidden="true">→</span>
          <span class="first-step-text">El primer paso es <a href="#contacto">escribirme y contarme qué querés trabajar</a>.</span>
        </p>
      </div>
    </section>

    <section class="wrap about section-space" id="sobre-euge" aria-labelledby="titulo-euge">
      <h2 id="titulo-euge">Soy Euge Buteler.</h2>
      <div class="about-copy">{site.bio.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="video-band band" id="videos" aria-labelledby="titulo-videos">
      <div class="wrap section-grid">
        <div>
          <h2 id="titulo-videos">Mis videos</h2>
          <p class="section-intro">Comparto reflexiones sobre la autoexigencia, el descanso y qué pasa cuando soltás un poco el control.</p>
        </div>
        <YouTubePlaylist {...site.video} />
      </div>
    </section>

    <section class="testimonials band" id="testimonios" aria-labelledby="titulo-testimonios">
      <div class="wrap">
        <h2 id="titulo-testimonios">Lo que me cuentan después de la mentoría</h2>
        <ul class="scenarios">
          {site.testimonials.map((quote) => (
            <li><blockquote>«{quote}»</blockquote></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="wrap section-space section-grid contact" id="contacto" aria-labelledby="titulo-contacto">
      <div>
        <h2 id="titulo-contacto">Hablemos de lo que querés trabajar.</h2>
        <p class="section-intro">Contame qué te gustaría trabajar en la mentoría.</p>
        <div class="hero-actions">
          <a class="button instagram-primary" href={site.instagram.messageUrl}>
            {site.contactLabel}<span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="instagram-profile" href={site.instagram.profileUrl}>
            Mi Instagram · <span>{site.instagram.handle}</span>
          </a>
        </div>
      </div>
      <ContactForm />
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="wordmark" href="/">{site.name}<span aria-hidden="true">.</span></a>
      <span class="site-version">{site.version}</span>
      <a href={site.instagram.profileUrl}>Mi Instagram <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
</BaseLayout>
